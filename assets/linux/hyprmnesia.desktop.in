# Reference template for documentation/audit only.
#
# The .desktop files Hyprmnesia ships are generated by `desktopEntry()` in
# src/install/launcher.ts so that the system installer (scripts/package.ts) and
# the per-user `hpm launcher` / `hpm autostart` commands stay in sync. Editing
# this file has no effect on the build; update the generator instead.
#
# @EXEC@ is the resolved hpm path: /usr/bin/hpm for the .deb, or the portable
# binary path (process.execPath) for `hpm launcher install`.
[Desktop Entry]
Type=Application
Version=1.0
Name=Hyprmnesia
GenericName=Screen & Audio Memory
Comment=Local-first screen and audio memory for desktop assistants
Exec=@EXEC@ start
TryExec=@EXEC@
Icon=hyprmnesia
Terminal=false
Categories=Utility;AudioVideo;Recorder;
Keywords=memory;capture;screenshot;audio;recall;mcp;assistant;
StartupNotify=false
X-GNOME-UsesNotifications=true
# Added only for the ~/.config/autostart copy (hpm autostart enable):
# X-GNOME-Autostart-enabled=true
